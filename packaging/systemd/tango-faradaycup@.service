# Installed by beamline-tango-devices (tango-devices packaging/systemd) - do not edit;
# override with a drop-in. Handbook Part 4, Ch33.
# Tango device server faraday_cup/%i.
# Site data in /etc/beamline-tango/%p-%i.env (the tango_ds role): TANGO_HOST,
# TANGO_ENDPOINT_HOST, TANGO_CORBA_PORT, TANGO_ZMQ_HEARTBEAT_PORT, TANGO_ZMQ_EVENT_PORT,
# TANGO_LOG_LEVEL. What it starts after (simulators or real instrument links) comes
# from the role's drop-ins in tango-faradaycup@%i.service.d/.
[Unit]
Description=Tango device server faraday_cup/%i (Faraday cup, GPIB via Prologix)
PartOf=tango-lab.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tango
Group=tango
# systemd doesn't read /etc/environment. TANGO_HOST and the two ZeroMQ ports are read by
# Tango from the environment; the CORBA port is set by -ORBendPoint, on the endpoint
# host's lab address.
EnvironmentFile=/etc/beamline-tango/%p-%i.env
ExecStart=/opt/beamline-tango/bin/python3 -u -m beamline_tango.devices.faraday_cup %i -ORBendPoint giop:tcp:${TANGO_ENDPOINT_HOST}:${TANGO_CORBA_PORT} -v${TANGO_LOG_LEVEL}
Restart=on-failure
# At most two starts per 10 s: systemd's start limit (5 in 10 s) never gives up on a unit
# that keeps failing while a peer is missing (Ch29).
RestartSec=5

# Hardening: the fleet set (roles/healthcheck, exposure 1.5, Ch16), as proven for these
# servers in Ch29 probe L3b. PrivateDevices keeps the host's /dev/pts, so a magnet's units
# share socat's ptys. Nothing is writable but the runtime directory and a private /tmp.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_NETLINK: without it libzmq aborts the server at startup (Ch29 probe L3).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=tango-lab.target
