# Installed by beamline-tango-devices (tango-devices packaging/systemd) - do not edit;
# override with a drop-in. Handbook Part 4, Ch33.
# Sardana MacroServer server MacroServer/%i (with its Door), from the package's runtime.
# Site data in /etc/beamline-tango/%p-%i.env: TANGO_HOST, TANGO_ENDPOINT_HOST,
# TANGO_CORBA_PORT, TANGO_ZMQ_HEARTBEAT_PORT, TANGO_ZMQ_EVENT_PORT, SARDANA_LOG_LEVEL,
# SARDANA_MACROSERVER_DEVICE, SARDANA_POOL_DEVICE.
[Unit]
Description=Sardana MacroServer server MacroServer/%i
PartOf=tango-lab.target
Wants=network-online.target
After=network-online.target
# A macro started in the first seconds after a Pool restart can hang for good (Ch31
# LAB 31.7): a Pool stop or restart takes the MacroServer of the same instance along
# (PartOf), a Pool start doesn't.
Wants=tango-pool@%i.service
After=tango-pool@%i.service
PartOf=tango-pool@%i.service

[Service]
Type=simple
User=tango
Group=tango
EnvironmentFile=/etc/beamline-tango/%p-%i.env
# Logs go to the journal only (see tango-pool@.service).
ExecStart=/opt/beamline-tango/bin/python3 -u /opt/beamline-tango/bin/MacroServer %i -ORBendPoint giop:tcp:${TANGO_ENDPOINT_HOST}:${TANGO_CORBA_PORT} --log-level ${SARDANA_LOG_LEVEL} --without-log-file True
# Started only once it knows every element its Pool has: its Door answers about a second
# earlier, and a macro started then fails (Ch31).
ExecStartPost=/usr/libexec/beamline-tango/tango-ds-sardana-ready ${SARDANA_MACROSERVER_DEVICE} ${SARDANA_POOL_DEVICE}
Restart=on-failure
# At most two starts per 10 s: systemd's start limit (5 in 10 s) never gives up on a unit
# that keeps failing while a peer is missing (Ch29).
RestartSec=5
# Hardening: the fleet set (roles/healthcheck, exposure 1.5, Ch16), as proven for these
# servers in Ch29 probe L3b. PrivateDevices keeps the host's /dev/pts, so a magnet's units
# share socat's ptys. Nothing is writable but the runtime directory and a private /tmp.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_NETLINK: without it libzmq aborts the server at startup (Ch29 probe L3).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=tango-lab.target
