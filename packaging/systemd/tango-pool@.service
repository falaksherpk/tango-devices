# Installed by beamline-tango-devices (tango-devices packaging/systemd) - do not edit;
# override with a drop-in. Handbook Part 4, Ch33.
# Sardana Pool server Pool/%i, from the package's runtime. Site data in
# /etc/beamline-tango/%p-%i.env: TANGO_HOST, TANGO_ENDPOINT_HOST, TANGO_CORBA_PORT,
# TANGO_ZMQ_HEARTBEAT_PORT, TANGO_ZMQ_EVENT_PORT, SARDANA_LOG_LEVEL. The devices it starts
# after come from the role's drop-ins in tango-pool@%i.service.d/. Its controllers are in
# /opt/beamline-tango/lib/python3.12/site-packages/beamline_tango/sardana_controllers
# (the Pool's PoolPath property, set by the role).
[Unit]
Description=Sardana Pool server Pool/%i
PartOf=tango-lab.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tango
Group=tango
EnvironmentFile=/etc/beamline-tango/%p-%i.env
# Logs go to the journal only: --without-log-file takes a value, and any non-empty one
# turns Sardana's own log file off (it would land in the private /tmp, gone at a restart).
ExecStart=/opt/beamline-tango/bin/python3 -u /opt/beamline-tango/bin/Pool %i -ORBendPoint giop:tcp:${TANGO_ENDPOINT_HOST}:${TANGO_CORBA_PORT} --log-level ${SARDANA_LOG_LEVEL} --without-log-file True
# Started only once it listens, so a MacroServer after it finds it serving (Ch31).
ExecStartPost=/usr/libexec/beamline-tango/tango-ds-wait listen ${TANGO_CORBA_PORT}
Restart=on-failure
# At most two starts per 10 s: systemd's start limit (5 in 10 s) never gives up on a unit
# that keeps failing while a peer is missing (Ch29).
RestartSec=5
# Hardening: the fleet set (roles/healthcheck, exposure 1.5, Ch16), as proven for these
# servers in Ch29 probe L3b. PrivateDevices keeps the host's /dev/pts, so a magnet's units
# share socat's ptys. Nothing is writable but the runtime directory and a private /tmp.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_NETLINK: without it libzmq aborts the server at startup (Ch29 probe L3).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=tango-lab.target
