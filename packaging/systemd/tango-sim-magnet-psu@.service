# Installed by beamline-tango-devices (tango-devices packaging/systemd) - do not edit;
# override with a drop-in. Handbook Part 4, Ch33.
# Simulator for the Tango lab, instance %i: on 127.0.0.1 or ptys only, never opened in
# a firewall.
[Unit]
Description=Fake magnet power supply for %i
PartOf=tango-lab.target
# A socat restart makes new ptys: the PSU restarts with its link (Ch29 probe L2).
BindsTo=tango-sim-magnet-link@%i.service
After=tango-sim-magnet-link@%i.service

[Service]
Type=simple
User=tango
Group=tango
ExecStart=/opt/beamline-tango/bin/python3 -u -m beamline_tango.simulators.fake_magnet_psu /run/tango-magnet-%i/psu
# Started only once it holds the instrument end of the link open.
ExecStartPost=/usr/libexec/beamline-tango/tango-ds-wait fd $MAINPID /run/tango-magnet-%i/psu
Restart=on-failure
# At most two starts per 10 s: systemd's start limit (5 in 10 s) never gives up on a unit
# that keeps failing while a peer is missing (Ch29).
RestartSec=5

# Hardening: the fleet set (roles/healthcheck, exposure 1.5, Ch16), as proven for these
# servers in Ch29 probe L3b. PrivateDevices keeps the host's /dev/pts, so a magnet's units
# share socat's ptys. Nothing is writable but the runtime directory and a private /tmp.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=tango-lab.target
